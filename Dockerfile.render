FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM mongo:7.0-jammy
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=10000 \
    MONGODB_URI=mongodb://127.0.0.1:27017/prontuario_render_demo \
    MONGODB_CONNECT_TIMEOUT_MS=45000 \
    PRONTUARIO_SEED=true
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY public ./public
COPY scripts/start-render-demo.sh ./scripts/start-render-demo.sh
USER mongodb
EXPOSE 10000
ENTRYPOINT ["/bin/bash", "./scripts/start-render-demo.sh"]
